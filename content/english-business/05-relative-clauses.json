   "id": "q7",
   "objective": "Defining vs. non-defining",
   "family": "q7",
   "type": "explain",
   "track": "explain",
   "prompt": "Read: defining vs. non-defining relative clauses",
   "solution": "Defining: essential information – we need it to know who/what is meant. No commas; “that” is possible; the pronoun can be left out when it is the object (the people she met). Non-defining: extra information – could be left out. Always commas; never “that”; always a relative pronoun (who, which, whose, whom).",
   "rubric": "Lesen und verstehen.",
   "sourceTitle": "Moodle EN · Relative clauses, theory",
   "sourceQuote": "Defining vs. non-defining",
   "page": 1,
   "seconds": 45,
   "options": [],
   "correct": []
  },
