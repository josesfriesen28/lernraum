{
  "name": "lernraum",
  "version": "0.8.0",
  "private": true,
  "description": "Persönliche Lern-App im Reel-Stil: Aufgabenpakete, aktives Abrufen, Wiederholungsplan. Läuft komplett im Browser (GitHub Pages).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "dev": "node scripts/build.mjs && node scripts/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.0",
    "typescript": "5.9.3"
  }
}
